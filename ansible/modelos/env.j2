# Segredos da app, gerado pelo Ansible a partir de ansible/modelos/env.j2 e do Vault (P5 da fase 1).
# Não editar à mão no servidor. Root, 0600.
#
# Os valores vão entre aspas simples: assim o Compose não lhes faz substituições ($). O deploy.yml
# recusa valores do Vault com aspas simples ou mudanças de linha.
POSTGRES_PASSWORD='{{ vault_postgres_password }}'
# A password vai codificada no endereço: um / ou um @ partiriam o URL. O urlencode deixa o / como está.
DATABASE_URL='postgres://daciaramella:{{ vault_postgres_password | urlencode | replace("/", "%2F") }}@postgres:5432/daciaramella'
ADMIN_PASSWORD_INICIAL='{{ vault_admin_password_inicial }}'
MOLONI_CLIENT_ID='{{ vault_moloni_client_id }}'
MOLONI_CLIENT_SECRET='{{ vault_moloni_client_secret }}'
MOLONI_CHAVE_CIFRA='{{ vault_moloni_chave_cifra }}'
AGE_PUBLIC_KEY='{{ vault_age_public_key }}'
